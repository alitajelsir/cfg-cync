echo 'Syncing $HOME configurations...'

git clone --depth 1 --quiet --bare --single-branch --branch main \
https://github.com/alitajelsir/cfg-sync.git "$HOME/.local/share/cfg-sync"

cfg () {
	/usr/bin/git --git-dir="$HOME/.local/share/cfg-sync" --work-tree=$HOME $@
}
cfg checkout 2>/dev/null

if [ $? = 0 ]; then
	echo 'Syncing completed successfully'
	else
		echo 'Backing up pre-existing files...'

		cfg checkout 2>&1 |
		grep -E "\s+\." | awk {'print $1'} | xargs -I'{}' \
		rsync --mkpath -aR --remove-source-files '{}' $HOME/.local/bak/cfg-bak
		cfg checkout

		echo 'Syncing completed successfully'
fi

cfg config --local status.showUntrackedFiles no
exit
