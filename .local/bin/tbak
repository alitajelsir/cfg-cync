#!/usr/bin/env zsh

# Check UID
if [[ "$(id -u)" == 0 ]]; then
	printf "Can not create backup as root\n"
	exit 1
fi

# Fix ownership
find "$HOME" "$PREFIX" -user root \
	-exec sudo chown "$USERNAME:$USERNAME" {} +

# Set backup directories
_dest=/sdcard/Android/bak/Termux
_src=/data/data/com.termux/files
_ver=$(date +%Y%m%d)

[[ -d "$_dest" ]] ||
	mkdir -p "$_dest"

# Start backup
printf "Creating backup in $_dest...\n"

setopt extended_glob glob_dots

typeset -a _tar_opts=(
	--use-compress-program="zstd --threads=0"
	--create
	--file="$_dest/termux_$_ver.bak.tar.zst"
	--directory="$_src"
)

typeset -a _exclusions=(
	'home/.cache'
	'home/.local/share/zsh/plugins'
	'home/.local/state'
	'usr/tmp/*'
)

typeset -a _targets=(
	"$_src/home"/^.suroot
	"$_src/home"/.suroot/.config/zsh/.zshrc(N)
	"$_src/usr"
)

tar "${_tar_opts[@]}" "${(@)_exclusions/#/--exclude=}" "${(@)_targets#$_src/}"

printf "Done\n"
exit
